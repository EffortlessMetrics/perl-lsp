{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/.ci/receipts/schemas/generated-files.schema.json",
  "title": "Generated File Ownership Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "changed_files",
    "expected_command",
    "missing_receipts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "override"]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
