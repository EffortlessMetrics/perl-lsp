{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/workflow-policy.schema.json",
  "title": "Workflow Policy Lint Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scanned_workflows",
    "violations",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scanned_workflows": {
      "type": "integer",
      "minimum": 0
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "workflow",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["error", "warning"]
        },
        "code": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
