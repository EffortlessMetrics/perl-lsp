{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/schemas/parser-concept-floor.schema.json",
  "title": "Parser Concept Floor Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "concepts_required",
    "concepts_hit",
    "missing_concepts",
    "violations"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "concepts_required": { "type": "array", "items": { "type": "string" } },
    "concepts_hit": { "type": "array", "items": { "type": "string" } },
    "missing_concepts": { "type": "array", "items": { "type": "string" } },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixture", "expected", "actual", "detail"],
        "properties": {
          "fixture": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
