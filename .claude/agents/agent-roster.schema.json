{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EffortlessMetrics/perl-lsp/master/.claude/agents/agent-roster.schema.json",
  "title": "Swarm Agent Roster",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_updated",
    "agents"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/agent"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "name_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty_string"
      }
    },
    "slash_entrypoint": {
      "type": "string",
      "pattern": "^/[a-z0-9-]+$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "class",
        "file",
        "spawned_by",
        "handoff_to",
        "first_entrypoints",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "class": {
          "type": "string",
          "enum": [
            "coordinator",
            "reusable_worker",
            "specialist_worker"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "docs_devex",
            "explore",
            "implementation",
            "quality",
            "quality_ops",
            "review",
            "scout"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.md$"
        },
        "spawned_by": {
          "$ref": "#/$defs/name_array"
        },
        "handoff_to": {
          "$ref": "#/$defs/name_array"
        },
        "first_entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slash_entrypoint"
          }
        },
        "owns": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nonempty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "coordinator"
              }
            }
          },
          "then": {
            "required": [
              "owns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "specialist_worker"
              }
            }
          },
          "then": {
            "required": [
              "category"
            ]
          }
        }
      ]
    }
  }
}
