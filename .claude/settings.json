{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "worktree": {
    "symlinkDirectories": [
      "target"
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(cargo *)",
      "Bash(just *)",
      "Bash(python3 *)",
      "Bash(bash *)",
      "Bash(sed *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(chmod *)",
      "Bash(diff *)",
      "Bash(find *)",
      "Bash(for *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" == *.rs ]]; then cargo +1.92.0 fmt -- \"$CLAUDE_FILE_PATH\" 2>/dev/null || cargo fmt -- \"$CLAUDE_FILE_PATH\" 2>/dev/null || true; fi"
          },
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATH\" == *.rs ]]; then cargo check --quiet --message-format=short 2>&1 | head -20 || true; fi"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/task-completed.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "builder|reviewer|reviewer-deep|ops|scout|plan-reviewer|wisdom|research-web|scout-parser|scout-lsp|scout-dap",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Standards: no unwrap/expect/panic in production (use ? or ok_or_else). No git stash in worktrees (shared list, use git restore). Set CARGO_TARGET_DIR per worktree. Never git add -A (use specific files). Run cargo fmt + clippy before committing. CLAUDE.md has full context.'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "builder|reviewer|reviewer-deep|ops|scout|plan-reviewer|wisdom|research-web|scout-parser|scout-lsp|scout-dap",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Context refresh: Orchestrator spawns agents directly from the catalog. Agents follow todo lists with step skills. Agents have autonomy within scope. Crate CLAUDE.md files provide domain context. Issues carry task specs.'"
          }
        ]
      }
    ]
  }
}
