{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "scorecard",
    "harness",
    "top_line_metrics",
    "integration_points",
    "tracked_signals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "const": "tracked_scaffold"
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_pass_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_stability_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "p95_time_to_first_useful_result_ms"
              }
            },
            "required": ["name"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "workflow_pass_rate",
              "workflow_stability_rate",
              "p95_time_to_first_useful_result_ms"
            ]
          },
          "state": {
            "type": "string",
            "enum": ["planned", "measured"]
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tracked_signals": {
      "type": "object",
      "required": [
        "workflow_inventory_total",
        "workflow_ci_tier_breakdown",
        "expected_outcome_density",
        "metric_coverage"
      ],
      "properties": {
        "workflow_inventory_total": {
          "type": "integer",
          "minimum": 0
        },
        "workflow_ci_tier_breakdown": {
          "type": "object",
          "required": ["pr", "nightly"],
          "properties": {
            "pr": {
              "type": "integer",
              "minimum": 0
            },
            "nightly": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "expected_outcome_density": {
          "type": "object",
          "required": [
            "total_expected_outcomes",
            "average_expected_outcomes_per_workflow"
          ],
          "properties": {
            "total_expected_outcomes": {
              "type": "integer",
              "minimum": 0
            },
            "average_expected_outcomes_per_workflow": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "metric_coverage": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "name",
              "workflows_covering",
              "total_workflows",
              "coverage_percent"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "workflows_covering": {
                "type": "integer",
                "minimum": 0
              },
              "total_workflows": {
                "type": "integer",
                "minimum": 0
              },
              "coverage_percent": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
