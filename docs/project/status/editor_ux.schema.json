{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "scorecard",
    "harness",
    "top_line_metrics",
    "integration_points",
    "confidence_signals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "enum": ["planning_scaffold", "tracked"]
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_pass_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_stability_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "p95_time_to_first_useful_result_ms"
              }
            },
            "required": ["name"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "workflow_pass_rate",
              "workflow_stability_rate",
              "p95_time_to_first_useful_result_ms"
            ]
          },
          "state": {
            "type": "string",
            "enum": ["planned", "measured"]
          },
          "owner": {
            "type": "string"
          },
          "value": {
            "type": ["number", "null"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "confidence_signals": {
      "type": "object",
      "required": [
        "manual_editor_smoke_workflows",
        "first_5_minutes_harness",
        "open_issue_burn_down"
      ],
      "properties": {
        "manual_editor_smoke_workflows": {
          "$ref": "#/$defs/signal"
        },
        "first_5_minutes_harness": {
          "$ref": "#/$defs/signal"
        },
        "open_issue_burn_down": {
          "$ref": "#/$defs/signal"
        }
      },
      "additionalProperties": false
    },
    "measured_source": {
      "type": ["string", "null"]
    },
    "measured_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "required": ["tracked_by", "state"],
      "properties": {
        "tracked_by": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["tracked_protocol", "measured", "external"]
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
