{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "scorecard",
    "harness",
    "burn_down",
    "top_line_metrics",
    "integration_points"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "const": "scorecard"
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "burn_down": {
      "type": "object",
      "required": ["source", "known_gap_issue_count", "known_gap_issue_refs"],
      "properties": {
        "source": {
          "type": "string"
        },
        "known_gap_issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "known_gap_issue_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_harness_scenario_count"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "known_gap_issue_count"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_stability_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "p95_time_to_first_useful_result_ms"
              }
            },
            "required": ["name"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "workflow_harness_scenario_count",
              "known_gap_issue_count",
              "workflow_stability_rate",
              "p95_time_to_first_useful_result_ms"
            ]
          },
          "state": {
            "type": "string",
            "enum": ["planned", "tracked", "measured"]
          },
          "owner": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
