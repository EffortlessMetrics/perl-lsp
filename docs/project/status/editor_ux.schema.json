{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "scorecard",
    "harness",
    "confidence_signals",
    "top_line_metrics",
    "integration_points"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "const": "tracked_signal_receipt"
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files", "ci_tier_coverage"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ci_tier_coverage": {
          "type": "object",
          "required": ["pr_workflow_count", "nightly_workflow_count"],
          "properties": {
            "pr_workflow_count": {
              "type": "integer",
              "minimum": 0
            },
            "nightly_workflow_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "confidence_signals": {
      "type": "object",
      "required": ["manual_editor_smoke", "first_5_minutes_harness", "open_issue_burndown"],
      "properties": {
        "manual_editor_smoke": {
          "$ref": "#/$defs/confidenceSignal"
        },
        "first_5_minutes_harness": {
          "$ref": "#/$defs/confidenceSignal"
        },
        "open_issue_burndown": {
          "$ref": "#/$defs/confidenceSignal"
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_pass_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_stability_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "p95_time_to_first_useful_result_ms"
              }
            },
            "required": ["name"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "workflow_pass_rate",
              "workflow_stability_rate",
              "p95_time_to_first_useful_result_ms"
            ]
          },
          "state": {
            "type": "string",
            "enum": ["measured"]
          },
          "owner": {
            "type": "string"
          },
          "workflow_coverage_count": {
            "type": "integer",
            "minimum": 0
          },
          "workflow_coverage_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "confidenceSignal": {
      "type": "object",
      "required": ["state", "tracking_method"],
      "properties": {
        "state": {
          "type": "string",
          "const": "tracked"
        },
        "tracking_method": {
          "type": "string"
        },
        "workflow_count": {
          "type": "integer",
          "minimum": 0
        },
        "pr_lane_workflow_count": {
          "type": "integer",
          "minimum": 0
        },
        "nightly_lane_workflow_count": {
          "type": "integer",
          "minimum": 0
        },
        "tracked_issue_link_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
