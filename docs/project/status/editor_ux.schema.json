{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "scorecard",
    "harness",
    "top_line_metrics",
    "manual_smoke",
    "known_gap_issues",
    "integration_points"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "const": "tracked_scorecard"
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_pass_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_stability_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "p95_time_to_first_useful_result_ms"
              }
            },
            "required": ["name"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "allOf": [
          {
            "if": {
              "properties": {
                "state": { "const": "measured" }
              }
            },
            "then": {
              "required": ["numerator", "denominator", "unit"]
            }
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "workflow_pass_rate",
              "workflow_stability_rate",
              "p95_time_to_first_useful_result_ms"
            ]
          },
          "state": {
            "type": "string",
            "enum": ["planned", "measured"]
          },
          "owner": {
            "type": "string"
          },
          "numerator": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "manual_smoke": {
      "type": "object",
      "required": ["protocol", "step_count", "steps"],
      "properties": {
        "protocol": { "type": "string" },
        "step_count": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "known_gap_issues": {
      "type": "object",
      "required": ["source", "count", "issues"],
      "properties": {
        "source": { "type": "string" },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
