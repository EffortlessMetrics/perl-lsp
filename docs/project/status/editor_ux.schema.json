{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_kind",
    "scorecard",
    "harness",
    "top_line_metrics",
    "integration_points",
    "tracked_signals"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "const": "planning_scaffold"
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_pass_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "workflow_stability_rate"
              }
            },
            "required": ["name"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "p95_time_to_first_useful_result_ms"
              }
            },
            "required": ["name"]
          }
        }
      ],
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "workflow_pass_rate",
              "workflow_stability_rate",
              "p95_time_to_first_useful_result_ms"
            ]
          },
          "state": {
            "type": "string",
            "enum": ["planned", "measured"]
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tracked_signals": {
      "type": "object",
      "required": [
        "first_five_minutes_harness",
        "workflow_scorecard_contract",
        "open_issue_burndown"
      ],
      "properties": {
        "first_five_minutes_harness": {
          "type": "object",
          "required": ["source", "state", "scenario_count"],
          "properties": {
            "source": { "type": "string" },
            "state": { "type": "string", "const": "tracked" },
            "scenario_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "workflow_scorecard_contract": {
          "type": "object",
          "required": ["source", "state", "workflow_count"],
          "properties": {
            "source": { "type": "string" },
            "state": { "type": "string", "const": "tracked" },
            "workflow_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "open_issue_burndown": {
          "type": "object",
          "required": ["source", "state", "open_issue_count", "open_issue_refs"],
          "properties": {
            "source": { "type": "string" },
            "state": { "type": "string", "const": "tracked" },
            "open_issue_count": { "type": "integer", "minimum": 0 },
            "open_issue_refs": {
              "type": "array",
              "items": { "type": "string", "pattern": "^#[0-9]+$" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
