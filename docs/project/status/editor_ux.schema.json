{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EffortlessMetrics/perl-lsp/docs/project/status/editor_ux.schema.json",
  "title": "Editor UX Scorecard Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "scorecard",
    "harness",
    "top_line_metrics",
    "integration_points"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scorecard": {
      "type": "string",
      "const": "editor_ux"
    },
    "harness": {
      "type": "object",
      "required": ["crate", "scenario_count", "scenario_files"],
      "properties": {
        "crate": {
          "type": "string",
          "const": "crates/perl-lsp-ux-tests"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "scenario_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "top_line_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state", "owner"],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["planned", "measured"]
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "integration_points": {
      "type": "object",
      "required": ["ci_lane", "release_lane", "status_update", "quality_surface"],
      "properties": {
        "ci_lane": {
          "type": "string"
        },
        "release_lane": {
          "type": "string"
        },
        "status_update": {
          "type": "string"
        },
        "quality_surface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
