# Disallow nested lockfiles; keep only the workspace root
**/Cargo.lock
!Cargo.lock

# Debug and build artifacts
/debug_parse/
/target/
/target-tests/
.build/
*.a
*.dylib
*.so
*.o
src/*
tree-sitter-perl.wasm
log.html

# Release artifacts
/releases/
*.tar.gz
*.zip
*.vsix

# Supply chain security artifacts (generated locally)
sbom-*.json
SHA256SUMS

# Property test regression files
**/tests/_proptest-regressions/

# Python cache files
scripts/__pycache__/
*.pyc

# Claude — agents/ is gitignored to allow swapping the active agents symlink.
# agents2/, agents3/, agents4/ etc. are version-tracked.
/.claude/agents/
# Worktrees used by Claude agent isolation — ephemeral, never committed.
/.claude/worktrees/

# Swarm ops — ignore the entire directory (contains repo mirror artifacts),
# but force-track the specific knowledge files we need.
.ops-perl-lsp/

