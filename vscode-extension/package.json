{
  "name": "perl-lsp-rs",
  "displayName": "Perl Language Server (perl-lsp)",
  "description": "Fast, native Perl 5 language server: go-to-definition, completions, diagnostics, refactoring, debugging, and 98 LSP/DAP features. Zero runtime dependencies.",
  "version": "0.12.0",
  "publisher": "EffortlessMetrics",
  "preview": true,
  "markdown": "github",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers",
    "Testing"
  ],
  "keywords": [
    "perl",
    "perl5",
    "language-server",
    "lsp",
    "debugger",
    "refactoring",
    "code-completion",
    "diagnostics",
    "vscodium",
    "open-vsx"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EffortlessMetrics/perl-lsp"
  },
  "bugs": {
    "url": "https://github.com/EffortlessMetrics/perl-lsp/issues"
  },
  "homepage": "https://github.com/EffortlessMetrics/perl-lsp#readme",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:perl",
    "onCommand:perl-lsp.restart",
    "onCommand:perl-lsp.showVersion",
    "onCommand:perl-lsp.reinstall",
    "onCommand:perl-lsp.checkSyntax",
    "onCommand:perl-lsp.runCurrentTest",
    "onCommand:perl-lsp.runAllTests",
    "onCommand:perl-lsp.formatDocument",
    "onCommand:perl-lsp.showIncPaths",
    "onCommand:perl-lsp.openModule",
    "onCommand:perl-lsp.showParserAst",
    "onCommand:perl-lsp.checkForUpdate",
    "onCommand:perl-lsp.createDebugConfig",
    "onCommand:perl-lsp.runHealthCheck",
    "onCommand:perl-lsp.openConfigurationGuide",
    "onWalkthrough:perl-lsp.gettingStarted"
  ],
  "contributes": {
    "languages": [
      {
        "id": "perl",
        "aliases": [
          "Perl",
          "perl",
          "Perl 5"
        ],
        "extensions": [
          ".pl",
          ".pm",
          ".pod",
          ".t",
          ".psgi"
        ],
        "firstLine": "^#!.*\\bperl\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "perl",
        "scopeName": "source.perl",
        "path": "./syntaxes/perl.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "perl"
      }
    ],
    "debuggers": [
      {
        "type": "perl",
        "label": "Perl",
        "program": "./out/extension.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Perl script to debug",
                "default": "${workspaceFolder}/script.pl"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the script",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "perlPath": {
                "type": "string",
                "description": "Path to the Perl executable",
                "default": "perl"
              },
              "includePaths": {
                "type": "array",
                "description": "Additional include paths (passed as -I)",
                "default": [],
                "items": {
                  "type": "string"
                }
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop at the first line",
                "default": true
              },
              "cwd": {
                "type": "string",
                "description": "Current working directory for the script",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables",
                "default": {}
              }
            }
          },
          "attach": {
            "properties": {
              "processId": {
                "type": "number",
                "description": "Attach to an existing Perl process by PID"
              },
              "host": {
                "type": "string",
                "description": "Host for TCP attach mode",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "Port for TCP attach mode",
                "default": 13603
              },
              "timeout": {
                "type": "number",
                "description": "TCP attach timeout in milliseconds",
                "default": 5000
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "perl",
            "request": "launch",
            "name": "Perl: Launch Script",
            "program": "${workspaceFolder}/script.pl",
            "stopOnEntry": true
          },
          {
            "type": "perl",
            "request": "attach",
            "name": "Perl: Attach to Debugger",
            "host": "localhost",
            "port": 13603,
            "timeout": 5000
          }
        ]
      }
